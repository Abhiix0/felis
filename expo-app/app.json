{
  "expo": {
    "name": "Spawn",
    "slug": "spawn-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "spawn",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0D0C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.spawn.personalos"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0D0C"
      },
      "package": "com.spawn.personalos",
      "navigationBar": {
        "backgroundColor": "#0D0D0C",
        "barStyle": "light-content"
      },
      "statusBar": {
        "backgroundColor": "#0D0D0C",
        "barStyle": "light-content"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
